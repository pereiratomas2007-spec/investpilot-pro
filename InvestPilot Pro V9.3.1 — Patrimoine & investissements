@charset "utf-8";

:root { --bg: #091321; --panel: #111e2e; --panel2: #18283c; --line: #2a3d54; --txt: #eff5fc; --muted: #9badc1; --green: #35d39a; --blue: #72adff; --red: #ff7488; --gold: #f2c56c; }

* { box-sizing: border-box; }

body { margin: 0px; background: radial-gradient(ellipse at 15% 0%,#173249 0,transparent 38%),var(--bg); color: var(--txt); font: 14px / 1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }

.app { max-width: 1320px; margin: auto; padding: 22px 16px 55px; }

.top { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 19px; }

.brand { display: flex; align-items: center; gap: 12px; }

.logo { width: 46px; height: 46px; border-radius: 15px; background: linear-gradient(135deg, rgb(50, 212, 155), rgb(105, 168, 255)); display: grid; place-items: center; color: rgb(6, 35, 27); font-weight: 900; font-size: 24px; }

.brand h1 { font-size: 21px; margin: 0px; }

.brand p { font-size: 12px; color: var(--muted); margin: 2px 0px 0px; }

.actions, .nav, .btnrow { display: flex; gap: 8px; flex-wrap: wrap; }

button { cursor: pointer; border: 1px solid var(--line); background: var(--panel2); color: var(--txt); border-radius: 10px; padding: 10px 13px; font-weight: 650; font-size: 12px; }

button:hover { filter: brightness(1.15); }

button.primary { background: var(--green); border-color: var(--green); color: rgb(5, 36, 26); }

button.danger { color: var(--red); }

button.active { background: rgb(29, 62, 66); border-color: rgb(40, 124, 105); color: rgb(194, 255, 231); }

.nav { overflow: auto; flex-wrap: nowrap; margin-bottom: 18px; padding-bottom: 4px; }

.nav button { white-space: nowrap; color: var(--muted); }

.page { display: none; }

.page.active { display: block; }

.grid { display: grid; grid-template-columns: repeat(4, minmax(0px, 1fr)); gap: 12px; }

.card { background: linear-gradient(145deg,var(--panel),#101a29); border: 1px solid var(--line); border-radius: 16px; padding: 16px; min-width: 0px; }

.metric .label, .label { font-size: 12px; color: var(--muted); }

.metric .value, .big { font-size: clamp(21px, 3vw, 29px); font-weight: 820; letter-spacing: -0.7px; margin: 8px 0px 3px; overflow-wrap: anywhere; }

.positive { color: var(--green); }

.negative { color: var(--red); }

.muted, .sub { color: var(--muted); font-size: 12px; }

.two { display: grid; grid-template-columns: 1.15fr 1fr; gap: 13px; margin-top: 13px; }

.three { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 12px; }

.sectionhead { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 22px 0px 12px; }

.sectionhead h2 { margin: 0px; font-size: 17px; }

.pill { display: inline-block; background: rgb(32, 54, 76); color: rgb(199, 221, 248); border-radius: 99px; padding: 4px 8px; font-size: 11px; }

.track { height: 9px; background: rgb(39, 57, 78); border-radius: 99px; overflow: hidden; }

.fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, rgb(50, 211, 154), rgb(110, 172, 255)); }

.barrow { display: grid; grid-template-columns: minmax(90px, 1fr) 2fr 80px; gap: 10px; align-items: center; margin: 12px 0px; font-size: 12px; }

.tablewrap { overflow: auto; }

table { border-collapse: collapse; width: 100%; min-width: 720px; }

td, th { padding: 11px 9px; border-bottom: 1px solid var(--line); text-align: left; font-size: 12px; }

th { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.45px; }

td.right, th.right { text-align: right; }

.empty { padding: 25px; text-align: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 12px; }

.formgrid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 11px; }

.field { display: flex; flex-direction: column; gap: 6px; }

.field.full { grid-column: 1 / -1; }

label { font-size: 12px; color: var(--muted); }

input, select, textarea { width: 100%; padding: 10px 11px; border: 1px solid var(--line); border-radius: 10px; background: rgb(11, 22, 37); color: var(--txt); font: inherit; min-width: 0px; }

input:focus, select:focus, textarea:focus { outline: 1px solid var(--blue); }

.formactions { grid-column: 1 / -1; display: flex; gap: 8px; flex-wrap: wrap; }

.note { font-size: 11px; color: var(--muted); line-height: 1.55; }

.modalback { display: none; position: fixed; inset: 0px; z-index: 8; background: rgba(2, 7, 17, 0.8); padding: 16px; overflow: auto; }

.modalback.show { display: grid; place-items: center; }

.modal { width: min(650px, 100%); background: var(--panel); border: 1px solid var(--line); border-radius: 17px; padding: 19px; max-height: 96vh; overflow: auto; }

.modal h2 { font-size: 18px; margin: 0px 0px 15px; }

.filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }

.filters > * { max-width: 220px; }

.foot { text-align: center; color: rgb(129, 147, 169); font-size: 11px; margin-top: 24px; }

.callout { border-left: 3px solid var(--gold); padding: 10px 12px; background: rgb(43, 40, 29); border-radius: 8px; color: rgb(245, 228, 183); font-size: 12px; }

@media (max-width: 850px) {
  .grid { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  .two { grid-template-columns: 1fr; }
  .three { grid-template-columns: 1fr; }
}

@media (max-width: 470px) {
  .app { padding: 15px 11px 40px; }
  .card { padding: 13px; }
  .formgrid { grid-template-columns: 1fr; }
  .field.full, .formactions { grid-column: auto; }
  .metric .value { font-size: 21px; }
}

.btnrow { display: flex; gap: 8px; flex-wrap: wrap; }

.metric .value { overflow-wrap: anywhere; }

#assistant .note { line-height: 1.7; }

.ai-chat { display: flex; flex-direction: column; gap: 10px; max-height: 390px; overflow-y: auto; padding: 2px 2px 14px; }

.chat-bubble { max-width: 92%; padding: 11px 13px; border-radius: 13px; white-space: pre-wrap; line-height: 1.55; overflow-wrap: anywhere; }

.chat-bubble.bot { align-self: flex-start; background: var(--panel2); border: 1px solid var(--line); }

.chat-bubble.user { align-self: flex-end; background: rgb(23, 75, 70); border: 1px solid rgb(40, 123, 112); }

.chat-compose { display: flex; gap: 9px; align-items: flex-end; }

.chat-compose textarea { flex: 1 1 0%; min-width: 0px; resize: vertical; background: var(--panel2); color: var(--txt); border: 1px solid var(--line); border-radius: 10px; padding: 11px; font: inherit; }

.quickAsk { font-size: 12px; }

.chat-compose button { min-height: 42px; }

@media (max-width: 470px) {
  .chat-compose { align-items: stretch; }
  .chat-compose button { padding: 9px; }
}

.ai-good { color: var(--green); }

.ai-warn { color: var(--gold); }

.ai-bad { color: var(--red); }

.ai-line { padding: 8px 0px; border-bottom: 1px solid var(--line); }

.chart-svg { display: block; width: 100%; height: auto; overflow: visible; }

.chart-legend { display: flex; flex-wrap: wrap; gap: 9px 14px; margin-top: 10px; }

.chart-legend span { font-size: 11px; color: var(--muted); }

.chart-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }

.chart-stat { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0px; border-bottom: 1px solid var(--line); }

.chart-stat b { font-variant-numeric: tabular-nums; }

.chart-months { display: grid; grid-template-columns: repeat(6, minmax(0px, 1fr)); gap: 6px; margin-top: 10px; }

.chart-months div { background: rgb(21, 38, 58); border-radius: 8px; padding: 7px; text-align: center; min-width: 0px; }

.chart-months b { display: block; font-size: 11px; overflow-wrap: anywhere; }

.chart-months small { font-size: 10px; color: var(--muted); }

.top .actions, .top button { display: none !important; }

@media (max-width: 470px) {
  .chart-months { grid-template-columns: repeat(4, minmax(0px, 1fr)); }
}
