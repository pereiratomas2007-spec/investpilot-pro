 <div class="card"><div class="formgrid">
  <div class="field"><label>Concentration maximale d’un projet Bricks (%)</label><input id="alertProjectLimit" type="number" min="1" max="100" step="1"></div>
  <div class="field"><label>Endettement immobilier maximal (%)</label><input id="alertDebtLimit" type="number" min="1" max="100" step="1"></div>
  <div class="field"><label>Baisse mensuelle du patrimoine à signaler (%)</label><input id="alertDropLimit" type="number" min="1" max="100" step="1"></div>
