function rowsToBricks(rows){
 if(!rows.length)throw Error('Le fichier ne contient aucune ligne.');
 let headerIndex=-1,headers=[];
 for(let i=0;i<Math.min(rows.length,15);i++){let h=(rows[i]||[]).map(normHead);let hasDate=h.some(x=>['date','dateoperation','datedeloperation','transactiondate','createdat'].includes(x));let hasType=h.some(x=>['type','operation','transactiontype','libelle'].includes(x));let hasAmount=h.some(x=>['montant','amount','montanteur','value','valeur'].includes(x));if(hasDate&&hasType&&hasAmount){headerIndex=i;headers=h;break}}
 if(headerIndex<0)throw Error('Je ne retrouve pas les colonnes Date, Type et Montant. Vérifie que tu as choisi l’export des transactions Bricks.');
 const find=(names)=>headers.findIndex(h=>names.includes(h));
 const ix={date:find(['date','dateoperation','datedeloperation','transactiondate','createdat']),type:find(['type','operation','transactiontype','libelle']),amount:find(['montant','amount','montanteur','value','valeur']),status:find(['statut','status','etat']),project:find(['projet','project','nomduprojet','propriete','property']),contract:find(['contrat','contract','typecontrat','typedecontrat']),brickPrice:find(['prixdelabrick','prixbrick','brickprice','prixunitaire','unitprice'])};
 let out=[];
 for(const row of rows.slice(headerIndex+1)){if(!row||!row.some(v=>String(v??'').trim()))continue;let date=parseBricksDate(row[ix.date]),type=String(row[ix.type]??'').trim(),amount=parseBricksAmount(row[ix.amount]);if(!date||!type||!Number.isFinite(amount))continue;
 let rawStatus=String(ix.status>=0?row[ix.status]:'Validée').trim();let status=/refus|reject/i.test(rawStatus)?'Refusée':/annul|cancel/i.test(rawStatus)?'Annulée':/traitement|pending|en cours/i.test(rawStatus)?'En traitement':/valid|accepted|success/i.test(rawStatus)?'Validée':(rawStatus||'Inconnu');
 let contract=ix.contract>=0?String(row[ix.contract]??'').trim():'';let project=ix.project>=0?String(row[ix.project]??'').trim():'';let price=ix.brickPrice>=0?parseBricksAmount(row[ix.brickPrice]):NaN;
 out.push({id:uid(),date,type,status,project,contract,amount,brickPrice:Number.isFinite(price)?price:null});
 }
 if(!out.length)throw Error('Aucune opération exploitable trouvée dans le fichier.');return out
}
