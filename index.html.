 if(overdue.length)items.push({level:'warn',title:`${overdue.length} objectif(s) après leur échéance`,body:'Une échéance est dépassée alors que le montant cible n’est pas atteint. Mets à jour la date ou le montant.'});
 const completed=db.goals.filter(g=>Number(g.target)>0&&Number(g.current)>=Number(g.target)).length;
