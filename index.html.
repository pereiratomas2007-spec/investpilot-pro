 if(pending)items.push({level:'info',title:`${pending} opération(s) Bricks en traitement`,body:'Ces opérations ne sont pas incluses dans les totaux financiers validés. Vérifie leur statut sur Bricks.'});
 const invalid=db.holdings.filter(x=>!Number.isFinite(Number(x.value))||!Number.isFinite(Number(x.invested))||Number(x.value)<0||Number(x.invested)<0).length;
 if(invalid)items.push({level:'warn',title:`${invalid} placement(s) à vérifier`,body:'Une valeur saisie est absente, négative ou invalide. Contrôle les fiches dans PEA & placements.'});
 const negative=db.properties.filter(x=>(Number(x.rent)||0)-(Number(x.charges)||0)-(Number(x.payment)||0)<0);
 if(negative.length)items.push({level:'warn',title:`${negative.length} bien(s) avec cash-flow négatif`,body:'Les loyers saisis ne couvrent pas les charges et mensualités indiquées. Vérifie les montants et la trésorerie nécessaire.'});
